---
// Fonts shown as a tight specimen sheet — one row per font, no cards.
// Newsprint-paper energy: feels like an editorial type sample, not a
// product feature spread. iA Writer Quattro isn't on Google Fonts, so
// we approximate with Inter for that one row.

const fonts = [
  {
    id: "ia-quattro",
    label: "iA Writer Quattro",
    pro: false,
    stack: '"iA Writer Quattro V", Inter, system-ui, sans-serif',
    note: "Default",
  },
  {
    id: "new-york",
    label: "New York",
    pro: false,
    stack: '"New York", "Iowan Old Style", Georgia, serif',
  },
  {
    id: "merriweather",
    label: "Merriweather",
    pro: true,
    stack: '"Merriweather", Georgia, serif',
  },
  {
    id: "noto-serif",
    label: "Noto Serif",
    pro: true,
    stack: '"Noto Serif", Georgia, serif',
  },
  {
    id: "inter",
    label: "Inter",
    pro: true,
    stack: '"Inter", system-ui, sans-serif',
  },
  {
    id: "jetbrains",
    label: "JetBrains Mono",
    pro: true,
    stack: '"JetBrains Mono", ui-monospace, monospace',
  },
  {
    id: "nanum",
    label: "Nanum Gothic Coding",
    pro: true,
    stack: '"Nanum Gothic Coding", ui-monospace, monospace',
  },
  {
    id: "vt323",
    label: "VT323",
    pro: true,
    stack: '"VT323", "Courier New", monospace',
    note: "Pairs with Matrix",
  },
];

const sample = "The quiet morning light fell across the page.";
---

<section id="fonts" class="fonts">
  <div class="container">
    <div class="section-head section-head-tight">
      <div class="eyebrow">Typography</div>
      <h2>Fonts that travel with the app.</h2>
      <p class="lede">
        Every font ships inside mMDd, so Mac and Windows render the same
        letterforms. Two free, six are a thank-you for supporters. Each
        theme remembers its own.
      </p>
    </div>

    <ul class="specimen-list">
      {fonts.map((f) => (
        <li class="specimen-row">
          <div class="specimen-name">
            <span class="sn-label">{f.label}</span>
            {f.note && <span class="sn-note">{f.note}</span>}
            <span class={`sn-tier ${f.pro ? "is-pro" : ""}`}>
              {f.pro ? "Supporter" : "Free"}
            </span>
          </div>
          <p class="specimen-sample" style={`font-family:${f.stack};`}>
            {sample}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head-tight {
    margin-bottom: 36px;
  }

  /* ---------- Specimen sheet ---------- */

  .specimen-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hr);
  }

  .specimen-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: 14px 4px;
    border-bottom: 1px solid var(--hr);
    transition: background-color 0.15s ease;
  }

  .specimen-row:hover {
    background: color-mix(in srgb, var(--chip-bg) 60%, transparent);
  }

  .specimen-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--ui-font);
  }

  .sn-label {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
    font-weight: 600;
  }

  .sn-note {
    font-size: 11px;
    color: var(--accent);
    font-weight: 500;
  }

  .sn-tier {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-soft);
    font-weight: 600;
  }

  .sn-tier.is-pro {
    color: var(--accent);
  }

  .specimen-sample {
    font-size: 22px;
    line-height: 1.35;
    color: var(--fg);
    margin: 0;
    /* Trim long font stacks visually — the sample is what matters. */
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 720px) {
    .specimen-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 16px 4px;
    }

    .specimen-name {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }

    .sn-tier {
      margin-top: 0;
    }

    .specimen-sample {
      font-size: 19px;
    }
  }
</style>
