---
// Fonts shown as a type specimen wall — each font announces itself by
// rendering its own name in its own typeface. No sample sentence, no
// tier badges. The "two free / six supporter" split lives only in the
// section lede; individual cells stay clean.

const fonts = [
  {
    id: "ia-quattro",
    label: "iA Writer Quattro",
    stack: '"iA Writer Quattro V", Inter, system-ui, sans-serif',
    note: "Default",
  },
  {
    id: "new-york",
    label: "New York",
    stack: '"New York", "Iowan Old Style", Georgia, serif',
  },
  {
    id: "merriweather",
    label: "Merriweather",
    stack: '"Merriweather", Georgia, serif',
  },
  {
    id: "noto-serif",
    label: "Noto Serif",
    stack: '"Noto Serif", Georgia, serif',
  },
  {
    id: "inter",
    label: "Inter",
    stack: '"Inter", system-ui, sans-serif',
  },
  {
    id: "jetbrains",
    label: "JetBrains Mono",
    stack: '"JetBrains Mono", ui-monospace, monospace',
  },
  {
    id: "nanum",
    label: "Nanum Gothic Coding",
    stack: '"Nanum Gothic Coding", ui-monospace, monospace',
  },
  {
    id: "vt323",
    label: "VT323",
    stack: '"VT323", "Courier New", monospace',
    note: "Pairs with Matrix",
  },
];
---

<section id="fonts" class="fonts">
  <div class="container">
    <div class="section-head section-head-tight">
      <div class="eyebrow">Typography</div>
      <h2>Fonts that travel with the app.</h2>
      <p class="lede">
        Every font ships inside mMDd, so Mac and Windows render the same
        letterforms. Two free, six are a thank-you for supporters. Each
        theme remembers its own.
      </p>
    </div>

    <ul class="specimen-grid">
      {fonts.map((f) => (
        <li class="specimen-cell">
          <p class="specimen-display" style={`font-family:${f.stack};`}>
            {f.label}
          </p>
          {f.note && <p class="specimen-note">{f.note}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head-tight {
    margin-bottom: 36px;
  }

  /* ---------- Specimen wall ---------- */

  .specimen-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* 1px gap on a HR-colored background produces hairline dividers
       between cells without writing per-cell borders. */
    gap: 1px;
    background: var(--hr);
    border: 1px solid var(--hr);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .specimen-cell {
    background: var(--bg);
    padding: 16px 22px;
    min-height: 90px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    transition: background-color 0.15s ease;
  }

  .specimen-cell:hover {
    background: color-mix(in srgb, var(--chip-bg) 55%, var(--bg));
  }

  .specimen-display {
    /* Big enough to read the typeface, small enough that Fonts doesn't
       dominate the page. Newsprint, not a type foundry homepage. */
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin: 0;
    /* Long names like "Nanum Gothic Coding" should wrap, not overflow. */
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .specimen-note {
    font-family: var(--ui-font);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    font-weight: 600;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 920px) {
    .specimen-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .specimen-cell {
      min-height: 80px;
      padding: 14px 20px;
    }
    .specimen-display {
      font-size: 18px;
    }
  }

  @media (max-width: 520px) {
    .specimen-grid {
      grid-template-columns: 1fr;
    }
    .specimen-cell {
      min-height: 100px;
      padding: 22px;
    }
  }
</style>
