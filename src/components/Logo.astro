---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<span class="logo" style={`--logo-size:${size}px`} aria-label="mMDd">
  <span class="logo-mark" aria-hidden="true">
    <span class="logo-text">mMDd</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: calc(var(--logo-size) * 0.22);
    background: #b03a2e;
    color: #f7f1e3;
    font-family: "New York", "Iowan Old Style", "Times New Roman", Georgia,
      serif;
    font-weight: 700;
    font-size: calc(var(--logo-size) * 0.3);
    letter-spacing: -0.06em;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 1px 2px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .logo-text {
    line-height: 1;
    transform: translateY(1px);
    padding: 0 2px;
  }
</style>
