---
// First-time install panel — Mac only for now. Since v1.1.0 the build is
// signed with the DOIE LLC Developer ID cert and notarized by Apple, so
// Gatekeeper accepts it on first launch. Two clicks, no Terminal.

import { DOWNLOAD, MAC_RELEASES_LIVE } from "../data/links.ts";
---

<section id="install" class="install">
  <div class="container">
    <div class="install-card">
      <div class="install-head">
        <span class="eyebrow eyebrow-tight">First-time install · 10 seconds</span>
        <h2>Drag, drop, done.</h2>
        <p class="lede">
          mMDd is signed with an Apple Developer ID and notarized by Apple,
          so macOS opens it without a Gatekeeper warning.
        </p>
      </div>

      <ol class="install-steps">
        <li>
          <span class="step-num" aria-hidden="true">1</span>
          <div class="step-body">
            <p>
              Open the DMG. Drag <strong>mMDd.app</strong> onto the
              <strong>Applications</strong> shortcut.
            </p>
          </div>
        </li>

        <li>
          <span class="step-num" aria-hidden="true">2</span>
          <div class="step-body">
            <p>
              Double-click <strong>mMDd</strong> in Applications. You're in.
            </p>
          </div>
        </li>
      </ol>

      <div class="install-tip-row">
        <div class="install-tip-icon" aria-hidden="true">
          <img src="/doc-icon-256.png" alt="" width="72" height="72" />
          <span class="install-tip-iconlabel">readme.md</span>
        </div>
        <p class="install-tip">
          <strong>Want every <kbd class="install-kbd">.md</kbd> file to open in mMDd?</strong>
          Right-click any Markdown file → <em>Get Info</em> → under
          <em>"Open with"</em> pick <em>mMDd</em> → click
          <em>"Change All…"</em>. Once it's the default, your Markdown files
          get the mMDd document icon (shown left).
        </p>
      </div>

      {MAC_RELEASES_LIVE && (
        <p class="install-arch">
          Intel Mac?
          <a href={DOWNLOAD.macIntel}>Download the Intel build</a>
          instead. (The big button above is Apple Silicon.)
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .install {
    padding-top: clamp(40px, 6vw, 80px);
  }

  .install-card {
    max-width: 760px;
    margin: 0 auto;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 48px);
    box-shadow: 0 18px 40px -22px var(--panel-shadow);
  }

  .install-head h2 {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    margin: 10px 0 14px;
  }

  .eyebrow-tight {
    margin-bottom: 4px;
  }

  .install-head .lede {
    font-family: var(--ui-font);
    font-size: 15px;
    color: var(--fg-soft);
    margin-top: 8px;
  }

  .install-steps {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .install-steps li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    align-items: start;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--chip-bg);
    border: 1px solid var(--border);
    color: var(--fg);
    font-weight: 700;
    font-size: 13px;
    font-family: var(--ui-font);
    margin-top: 1px;
  }

  .step-body p {
    color: var(--fg);
    font-size: 15px;
    line-height: 1.55;
  }

  .step-body strong {
    font-weight: 600;
  }

  .install-tip-row {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--hr);
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .install-tip-icon {
    flex-shrink: 0;
    width: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }
  .install-tip-icon img {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 8px;
  }
  .install-tip-iconlabel {
    font-family: var(--ui-font);
    font-size: 10px;
    color: var(--fg-soft);
  }
  .install-tip {
    margin: 0;
    color: var(--fg-soft);
    font-size: 13.5px;
    line-height: 1.65;
  }
  @media (max-width: 580px) {
    .install-tip-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }

  .install-tip strong {
    color: var(--fg);
    font-weight: 600;
  }

  .install-tip em {
    color: var(--fg);
    font-style: normal;
    font-weight: 500;
  }

  .install-kbd {
    display: inline-block;
    background: var(--chip-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 5px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    color: var(--fg);
  }

  .install-arch {
    margin-top: 14px;
    font-size: 13px;
    color: var(--fg-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
  }

  .install-arch a {
    font-weight: 500;
  }
</style>
