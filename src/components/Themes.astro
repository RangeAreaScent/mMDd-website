---
// Theme palettes mirror the app's themes.css so the preview cards are
// pixel-accurate. Layout is a simple Typora-style cascade — windows
// stacked left-to-right, rightmost fully visible, the rest peek out.

const themes = [
  {
    id: "mmdd",
    label: "mMDd",
    bg: "#ffffff",
    fg: "#2c2c2e",
    fgSoft: "#6e6e73",
    accent: "#4c6ef5",
    border: "#e9e9ec",
    codeBg: "#f6f6f7",
  },
  {
    id: "mmdd-dark",
    label: "mMDd dark",
    bg: "#1c1c22",
    fg: "#d4d4d8",
    fgSoft: "#8a8a93",
    accent: "#7c9cf5",
    border: "#2e2e36",
    codeBg: "#26262e",
  },
  {
    id: "solarized",
    label: "Solarized",
    bg: "#fdf6e3",
    fg: "#586e75",
    fgSoft: "#93a1a1",
    accent: "#268bd2",
    border: "#eee8d5",
    codeBg: "#eee8d5",
  },
  {
    id: "night-owl",
    label: "Night Owl",
    bg: "#011627",
    fg: "#d6deeb",
    fgSoft: "#5f7e97",
    accent: "#82aaff",
    border: "#122d42",
    codeBg: "#0b2942",
  },
  {
    id: "forest",
    label: "Forest",
    bg: "#1b2420",
    fg: "#cdd6cf",
    fgSoft: "#7c8a80",
    accent: "#87c38f",
    border: "#2b3a32",
    codeBg: "#22302a",
  },
  {
    id: "coder",
    label: "Coder",
    bg: "#0c0f0d",
    fg: "#b8c2b9",
    fgSoft: "#6e7c70",
    accent: "#00ff88",
    border: "#1a1f1c",
    codeBg: "#131816",
  },
  {
    id: "matrix",
    label: "Matrix",
    bg: "#000000",
    fg: "#6ee06e",
    fgSoft: "#2e6b2e",
    accent: "#6ee06e",
    border: "#143014",
    codeBg: "#060c06",
  },
  {
    id: "newsprint-dark",
    label: "Newsprint dark",
    bg: "#1c1a17",
    fg: "#e8e3d6",
    fgSoft: "#a09b8e",
    accent: "#d2876d",
    border: "#2e2a26",
    codeBg: "#26221e",
  },
  {
    id: "newsprint",
    label: "Newsprint",
    bg: "#f7f7f4",
    fg: "#2b2b2b",
    fgSoft: "#6b6b6b",
    accent: "#b03a2e",
    border: "#e0e0da",
    codeBg: "#ededea",
    isDefault: true,
  },
];
---

<section id="themes" class="themes">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Themes</div>
      <h2>Nine themes.<br />One feels like home.</h2>
      <p class="lede">
        Four ship free with every install. Five more come as a thank-you for
        supporters. Newsprint is the default — warm paper and vintage red.
      </p>
    </div>

    <div class="theme-deck-wrap" data-theme-deck>
      <div class="theme-deck">
        {themes.map((t, i) => (
          <article
            class="deck-card"
            style={`
              --t-bg:${t.bg};
              --t-fg:${t.fg};
              --t-fg-soft:${t.fgSoft};
              --t-accent:${t.accent};
              --t-border:${t.border};
              --t-code:${t.codeBg};
              --idx:${i};
            `}
            aria-label={t.label}
          >
            <div class="card-window">
              <div class="card-titlebar">
                <span class="td-dot" style="background:#ff5f57"></span>
                <span class="td-dot" style="background:#febc2e"></span>
                <span class="td-dot" style="background:#28c840"></span>
                <span class="td-name">{t.label}{t.isDefault && " · Default"}</span>
              </div>
              <div class="card-body">
                <div class="cd-h">A Few Lines</div>
                <p class="cd-p">
                  A clean room and an empty page —
                  <em>that's all you need to begin</em>.
                </p>
                <p class="cd-p">
                  Pour the coffee. <a class="cd-link">Open the file.</a>
                </p>
                <div class="cd-quote">"a quiet line."</div>
                <pre class="cd-code">
<span class="cd-tok-k">const</span> idea = <span class="cd-tok-s">"spark"</span>;</pre>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Deck stage ---------- */

  .theme-deck-wrap {
    max-width: 1100px;
    margin: 0 auto;
    /* Hide the part of the cascade that drifts past the right edge —
       it's intentional that the front card is centered-ish and the
       leftmost cards peek out only on the left. */
    overflow: visible;
  }

  .theme-deck {
    position: relative;
    /* Tall enough for the card window + its content. */
    height: 380px;
    /* The cascade itself is left-aligned in the container, but the
       rightmost (front) card lands near the right edge — which reads
       as "this is the default, click around to compare". */
  }

  /* ---------- Each card = one app window ---------- */

  .deck-card {
    position: absolute;
    top: 0;
    left: calc(var(--idx) * 78px);
    width: 360px;
    height: 100%;
    z-index: var(--idx);
    /* No 3D, no rotation. Just a clean horizontal cascade. */
    transition:
      opacity 0.5s ease var(--enter-delay, 0ms),
      transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) var(--enter-delay, 0ms);
    --enter-delay: calc(var(--idx) * 55ms);
  }

  .card-window {
    width: 100%;
    height: 100%;
    background: var(--t-bg);
    color: var(--t-fg);
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--t-border) 80%, transparent);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 22px 36px -22px rgba(0, 0, 0, 0.5),
      0 6px 14px -6px rgba(0, 0, 0, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.05) inset;
  }

  .card-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 16px 9px;
    border-bottom: 1px solid var(--t-border);
    background: color-mix(in srgb, var(--t-bg) 92%, var(--t-fg));
    flex-shrink: 0;
  }

  .td-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .td-name {
    flex: 1;
    text-align: center;
    font-family: var(--ui-font);
    font-size: 11px;
    color: var(--t-fg-soft);
    /* Pull left to compensate for the dots' width so the name sits
       visually centered. */
    margin-left: -35px;
  }

  .card-body {
    flex: 1;
    padding: 22px 24px;
    font-family: var(--body-font);
    font-size: 13px;
    line-height: 1.55;
    overflow: hidden;
  }

  .cd-h {
    font-family: var(--body-font);
    font-weight: 700;
    font-size: 17px;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--t-border);
    color: var(--t-fg);
    letter-spacing: -0.01em;
  }

  .cd-p {
    margin: 0 0 10px;
    color: var(--t-fg);
  }

  .cd-p em {
    color: var(--t-fg-soft);
    font-style: italic;
  }

  .cd-link {
    color: var(--t-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cd-quote {
    margin: 10px 0;
    padding: 2px 0 2px 12px;
    border-left: 3px solid var(--t-accent);
    color: var(--t-fg-soft);
    font-style: italic;
    font-size: 12px;
  }

  .cd-code {
    background: var(--t-code);
    padding: 8px 12px;
    border-radius: 5px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--t-fg);
    margin: 12px 0 0;
    white-space: pre;
    overflow: hidden;
  }

  .cd-tok-k {
    color: var(--t-accent);
  }

  .cd-tok-s {
    color: color-mix(in srgb, var(--t-accent) 70%, var(--t-fg));
  }

  /* ---------- Scroll-in: cards fade in left → right ---------- */

  .theme-deck-wrap:not(.in-view) .deck-card {
    opacity: 0;
    transform: translateX(-24px);
  }

  .theme-deck-wrap.in-view .deck-card {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1100px) {
    .theme-deck {
      height: 340px;
    }
    .deck-card {
      left: calc(var(--idx) * 65px);
      width: 320px;
    }
  }

  @media (max-width: 880px) {
    .deck-card {
      left: calc(var(--idx) * 50px);
      width: 280px;
    }
    .card-body {
      padding: 18px 20px;
      font-size: 12.5px;
    }
  }

  @media (max-width: 680px) {
    /* Drop to a horizontal scroll snap on phones — the cascade is too
       cramped at this size. */
    .theme-deck-wrap {
      margin-left: calc(-1 * var(--pad));
      margin-right: calc(-1 * var(--pad));
      padding-left: var(--pad);
      padding-right: var(--pad);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .theme-deck {
      height: 320px;
      width: max-content;
      display: flex;
      gap: 14px;
    }
    .deck-card {
      position: relative;
      top: 0;
      left: 0;
      flex-shrink: 0;
      width: 280px;
      scroll-snap-align: start;
    }
  }

  /* ---------- Reduced motion ---------- */

  @media (prefers-reduced-motion: reduce) {
    .deck-card,
    .theme-deck-wrap:not(.in-view) .deck-card {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Just trigger the fade-in cascade when the section scrolls into view.
  // No hover, no click — the cascade is a static display.
  const wrap = document.querySelector("[data-theme-deck]");
  if (wrap) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    io.observe(wrap);
  }
</script>
