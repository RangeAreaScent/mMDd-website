---
// Theme palettes mirror the app's themes.css so the preview cards are
// pixel-accurate. Pro themes get a star badge.

const themes = [
  {
    id: "mmdd",
    label: "mMDd",
    pro: false,
    dark: false,
    bg: "#ffffff",
    fg: "#2c2c2e",
    fgSoft: "#6e6e73",
    accent: "#4c6ef5",
    border: "#e9e9ec",
    codeBg: "#f6f6f7",
  },
  {
    id: "mmdd-dark",
    label: "mMDd dark",
    pro: false,
    dark: true,
    bg: "#1c1c22",
    fg: "#d4d4d8",
    fgSoft: "#8a8a93",
    accent: "#7c9cf5",
    border: "#2e2e36",
    codeBg: "#26262e",
  },
  {
    id: "newsprint",
    label: "Newsprint",
    pro: false,
    dark: false,
    bg: "#f7f7f4",
    fg: "#2b2b2b",
    fgSoft: "#6b6b6b",
    accent: "#b03a2e",
    border: "#e0e0da",
    codeBg: "#ededea",
    note: "Default",
  },
  {
    id: "newsprint-dark",
    label: "Newsprint dark",
    pro: false,
    dark: true,
    bg: "#1c1a17",
    fg: "#e8e3d6",
    fgSoft: "#a09b8e",
    accent: "#d2876d",
    border: "#2e2a26",
    codeBg: "#26221e",
  },
  {
    id: "solarized",
    label: "Solarized",
    pro: true,
    dark: false,
    bg: "#fdf6e3",
    fg: "#586e75",
    fgSoft: "#93a1a1",
    accent: "#268bd2",
    border: "#eee8d5",
    codeBg: "#eee8d5",
  },
  {
    id: "night-owl",
    label: "Night Owl",
    pro: true,
    dark: true,
    bg: "#011627",
    fg: "#d6deeb",
    fgSoft: "#5f7e97",
    accent: "#82aaff",
    border: "#122d42",
    codeBg: "#0b2942",
  },
  {
    id: "forest",
    label: "Forest",
    pro: true,
    dark: true,
    bg: "#1b2420",
    fg: "#cdd6cf",
    fgSoft: "#7c8a80",
    accent: "#87c38f",
    border: "#2b3a32",
    codeBg: "#22302a",
  },
  {
    id: "coder",
    label: "Coder",
    pro: true,
    dark: true,
    bg: "#0c0f0d",
    fg: "#b8c2b9",
    fgSoft: "#6e7c70",
    accent: "#00ff88",
    border: "#1a1f1c",
    codeBg: "#131816",
  },
  {
    id: "matrix",
    label: "Matrix",
    pro: true,
    dark: true,
    bg: "#000000",
    fg: "#6ee06e",
    fgSoft: "#2e6b2e",
    accent: "#6ee06e",
    border: "#143014",
    codeBg: "#060c06",
  },
];

// Per-card lean angles — small, varied so the row looks like books that
// settled at slightly different tilts. Pattern repeats every 3 (one shelf).
const leanAngles = [-7, 4, -3, 6, -5, 2, -4, 5, -6];

// Group themes into rows of three (one row = one shelf).
const shelves: (typeof themes)[] = [];
for (let i = 0; i < themes.length; i += 3) {
  shelves.push(themes.slice(i, i + 3));
}
---

<section id="themes" class="themes">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Themes</div>
      <h2>Nine themes.<br />One feels like home.</h2>
      <p class="lede">
        Four themes are free and ship with every install. Five more come as a
        small thank-you for supporters — including the iconic Newsprint, our
        default, with its warm paper and vintage red.
      </p>
    </div>

    <div class="theme-stage" data-theme-stage>
      <div class="theme-shelves">
        {shelves.map((shelfThemes, shelfIdx) => (
          <div class="theme-shelf">
            <div class="theme-shelf-row">
              {shelfThemes.map((t, cardIdx) => {
                const globalIdx = shelfIdx * 3 + cardIdx;
                const lean = leanAngles[globalIdx] ?? 0;
                return (
                  <article
                    class={`theme-card theme-card-stack ${t.dark ? "is-dark" : "is-light"}`}
                    style={`
                      --t-bg:${t.bg};
                      --t-fg:${t.fg};
                      --t-fg-soft:${t.fgSoft};
                      --t-accent:${t.accent};
                      --t-border:${t.border};
                      --t-code:${t.codeBg};
                      --lean:${lean}deg;
                      --stagger:${globalIdx * 70}ms;
                    `}
                    data-card
                  >
                    <div class="theme-preview">
                      <div class="tp-titlebar">
                        <span class="tp-dot" style="background:#ff5f57"></span>
                        <span class="tp-dot" style="background:#febc2e"></span>
                        <span class="tp-dot" style="background:#28c840"></span>
                      </div>
                      <div class="tp-body">
                        <div class="tp-h">A Few Lines</div>
                        <div class="tp-line"></div>
                        <div class="tp-line tp-line-short"></div>
                        <div class="tp-quote">"a quiet line."</div>
                        <div class="tp-code">
                          <span class="tp-tok-k">const</span>
                          <span class="tp-tok-i"> idea</span>
                          <span> = "spark";</span>
                        </div>
                      </div>
                    </div>
                    <div class="theme-meta">
                      <div class="theme-name">
                        {t.label}
                        {t.note && <span class="theme-note">{t.note}</span>}
                      </div>
                      {t.pro ? (
                        <span class="badge">Supporter</span>
                      ) : (
                        <span class="badge-soft">Free</span>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
            <div class="theme-shelf-board" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Stage: the room we view the shelf from ---------- */

  .theme-stage {
    perspective: 1800px;
    perspective-origin: 50% 25%;
    padding: 20px 0 0;
  }

  .theme-shelves {
    display: flex;
    flex-direction: column;
    gap: 36px;
    transform-style: preserve-3d;
  }

  /* ---------- A single shelf (one row) ---------- */

  .theme-shelf {
    position: relative;
    /* Slight tilt of the whole shelf — like looking down at it. */
    transform: rotateX(6deg);
    transform-style: preserve-3d;
  }

  .theme-shelf-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    transform-style: preserve-3d;
  }

  /* ---------- Wooden shelf board under each row ---------- */

  .theme-shelf-board {
    margin-top: -2px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--accent) 28%, var(--border)) 0%,
      color-mix(in srgb, var(--accent) 14%, var(--border)) 55%,
      var(--border) 100%
    );
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05) inset,
      0 12px 20px -16px var(--panel-shadow);
    transform: translateZ(-2px);
  }

  /* ---------- Each "book" / theme card ---------- */

  /* Default = pre-scroll resting state: faded, sunk slightly into the shelf.
     Single source of truth for transform — no double-declares. */
  .theme-card-stack {
    transform-origin: 50% 100%;
    transform: rotateY(var(--lean, 0deg)) translateY(28px);
    opacity: 0;
    transition:
      transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1)
        var(--stagger, 0ms),
      opacity 0.55s ease var(--stagger, 0ms),
      box-shadow 0.3s ease;
    will-change: transform, opacity;
    box-shadow:
      0 12px 22px -14px var(--panel-shadow),
      0 2px 6px -3px rgba(0, 0, 0, 0.12);
  }

  /* Scrolled into view → books rise to the shelf and lean naturally. */
  .theme-stage.in-view .theme-card-stack {
    transform: rotateY(var(--lean, 0deg));
    opacity: 1;
  }

  /* Hover (only meaningful after rise): pull the book forward. */
  .theme-stage.in-view .theme-card-stack:hover {
    transform: rotateY(0deg) translateZ(60px) translateY(-8px);
    box-shadow:
      0 28px 50px -22px var(--panel-shadow),
      0 6px 14px -8px rgba(0, 0, 0, 0.2);
    z-index: 2;
  }

  /* Shelf board fades in slightly after the books. */
  .theme-shelf-board {
    opacity: 0;
    transition: opacity 0.6s ease 0.15s;
  }

  .theme-stage.in-view .theme-shelf-board {
    opacity: 1;
  }

  /* ---------- Inherited card internals (unchanged) ---------- */

  .theme-card {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .theme-preview {
    background: var(--t-bg);
    color: var(--t-fg);
    padding: 12px 16px 18px;
    border-bottom: 1px solid var(--border);
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
  }

  .tp-titlebar {
    display: flex;
    gap: 5px;
    margin-bottom: 14px;
  }

  .tp-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .tp-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--body-font);
  }

  .tp-h {
    font-weight: 700;
    font-size: 14px;
    color: var(--t-fg);
    padding-bottom: 5px;
    border-bottom: 1px solid var(--t-border);
  }

  .tp-line {
    height: 6px;
    border-radius: 3px;
    background: var(--t-fg-soft);
    opacity: 0.35;
  }

  .tp-line-short {
    width: 60%;
  }

  .tp-quote {
    font-style: italic;
    font-size: 11px;
    color: var(--t-fg-soft);
    border-left: 2px solid var(--t-accent);
    padding-left: 8px;
    line-height: 1.4;
  }

  .tp-code {
    background: var(--t-code);
    padding: 6px 8px;
    border-radius: 4px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--t-fg);
    margin-top: auto;
  }

  .tp-tok-k {
    color: var(--t-accent);
  }

  .tp-tok-i {
    color: var(--t-fg);
    opacity: 0.85;
  }

  .theme-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
  }

  .theme-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--fg);
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }

  .theme-note {
    font-size: 11px;
    color: var(--fg-soft);
    font-weight: 500;
  }

  /* ---------- Responsive: collapse the bookshelf on small screens ---------- */

  @media (max-width: 920px) {
    .theme-shelf {
      transform: none;
    }

    .theme-shelf-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme-card-stack {
      transform: none !important;
    }

    .theme-card-stack:hover {
      transform: translateY(-3px) !important;
    }

    .theme-stage {
      perspective: none;
    }

    .theme-shelf-board {
      display: none;
    }
  }

  @media (max-width: 580px) {
    .theme-shelf-row {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Honor reduced motion ---------- */

  @media (prefers-reduced-motion: reduce) {
    .theme-shelf {
      transform: none;
    }
    .theme-card-stack {
      transform: none !important;
      opacity: 1 !important;
      transition: none;
    }
    .theme-shelf-board {
      opacity: 1;
    }
  }
</style>

<script>
  // Trigger the "books rise onto the shelf" animation when the section
  // scrolls into view. Once is enough — books don't fall off the shelf.
  const stage = document.querySelector("[data-theme-stage]");
  if (stage) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.18 },
    );
    io.observe(stage);
  }
</script>
