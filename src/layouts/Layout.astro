---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mMDd — Clean. Light. Free. Markdown editor.",
  description = "A minimal, fast Markdown editor for macOS and Windows. Free forever — supporters get a thank-you code for extra themes and fonts.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="newsprint">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Merriweather:wght@400;700&family=Nanum+Gothic+Coding&family=Noto+Serif:wght@400;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Newsprint is the signature default. Respect an explicit user toggle
      // (saved in localStorage), but do NOT auto-flip to dark on system
      // preference — first impression should always be the paper theme.
      (function () {
        try {
          var saved = localStorage.getItem("mmdd-site-theme");
          if (saved === "dark" || saved === "newsprint") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
